[{"model": "core.user", "pk": 1, "fields": {"email": "kurobautista2006@gmail.com", "userName": "Ynand", "codePass": "pbkdf2_sha256$1500000$mgpWN766vvZoA8F6Nnz7qW$KdonFam7X9OqwVeXuaCGyysFC1XF3UsaWTa2gPUPO2Q=", "role": "admin", "created_at": "2026-09-18T03:41:36.474Z"}}, {"model": "core.user", "pk": 2, "fields": {"email": "karllaurencegloria0702@gmail.com", "userName": "Karl", "codePass": "pbkdf2_sha256$1500000$2AfNBCVfgn88Anqou8Gf9f$WSApMuJd6/+MesXFnHrgISIrZ/6HbqKueps5zazc8bc=", "role": "admin", "created_at": "2026-09-18T03:43:53.708Z"}}, {"model": "core.user", "pk": 11, "fields": {"email": "xxdestroyer709@gmail.com", "userName": "vcvggfd", "codePass": "pbkdf2_sha256$1500000$RKTFZvdDp51znqRN6eHgWw$EOrjXhaN8NpWX0234JK6LkVXLAuaSHQ+XAB1XwH3hQQ=", "role": "student", "created_at": "2026-09-21T06:26:10.402Z"}}, {"model": "core.subject", "pk": 1, "fields": {"title": "Differential Calculus", "description": "This platform is a digital learning resource for Differential Calculus, offering organized lessons, formula references, and video tutorials to help students grasp core concepts more easily. It covers key topics — from Relations and Functions through Limits, Derivatives, Maxima/Minima, Differentials, and Partial Derivatives — each paired with definitions, essential formulas, and supplementary videos for deeper understanding. The goal is to make calculus more approachable and support independent learning, while building students' analytical and problem-solving skills for use in math, engineering, and other scientific fields.", "category": "MATHEMATICS", "course_code": "114"}}, {"model": "core.subject", "pk": 2, "fields": {"title": "Mathematics For Engineers", "description": "Mathematics is an important subject for engineering students because its concepts are commonly used in everyday activities and in solving real-world engineering problems. This website provides a simple and organized way for students to learn mathematics through clear explanations, examples, practice exercises, and interactive learning materials.\r\n\r\nThe website covers topics such as Basic Concepts of Trigonometry, Trigonometric Functions, Solution of Right and Oblique Triangles, Trigonometric Identities, Composite Angles, Advanced Algebra, Quadratic Equations, Word Problems, Plane Geometry, Quadrilaterals, Circles, Solid Geometry, Sequences and Series, Arithmetic Progression, and Geometric Progression. These lessons are designed to help students improve their understanding, application, analysis, and problem-solving skills while preparing them for higher-level engineering subjects.", "category": "MATHEMATICS", "course_code": "113"}}, {"model": "core.topic", "pk": 1, "fields": {"subject": 1, "title": "Relations, Functions, Limits, and Continuity", "notes": "* Definition of Relation and Function\n* Graphs and Types of Functions\n* Computations on Functions\n* Operations with Functions\n* Functions as Mathematical Models\n* Limits\n* Theorems on Limits\n* Directional Limits\n* Limit Theorem of Trigonometric Function\n* Unbounded Functions\n* Continuity", "youtube_url": "https://www.youtube.com/watch?v=1kz6hNDlEEg&list=RD1kz6hNDlEEg&start_radio=1", "order": 1}}, {"model": "core.topic", "pk": 2, "fields": {"subject": 1, "title": "Derivatives of Algebraic Functions", "notes": "* Derivative as Slope and Rate of Change\r\n* Three-Step Rule in Finding the Derivative of a Function\r\n* Differentiation Formulas\r\n* Derivative as Slope\r\n* Derivative as Rate of Change\r\n* The Chain Rule\r\n* Higher-Order Derivatives\r\n* Implicit Differentiation", "youtube_url": "https://www.youtube.com/watch?v=1kz6hNDlEEg&list=RD1kz6hNDlEEg&start_radio=1", "order": 2}}, {"model": "core.topic", "pk": 3, "fields": {"subject": 1, "title": "Graphs and Properties", "notes": "* Equations of Tangent and Normal Lines\r\n* Increasing and Decreasing Function\r\n* Concavity\r\n* Sketching Polynomial Curves", "youtube_url": "https://www.youtube.com/watch?v=1kz6hNDlEEg&list=RD1kz6hNDlEEg&start_radio=1", "order": 3}}, {"model": "core.topic", "pk": 4, "fields": {"subject": 1, "title": "Applications of Maxima and Minima", "notes": "* Optimization Problems\r\n* Time Rates", "youtube_url": "https://www.youtube.com/watch?v=1kz6hNDlEEg&list=RD1kz6hNDlEEg&start_radio=1", "order": 4}}, {"model": "core.topic", "pk": 5, "fields": {"subject": 1, "title": "Differentials", "notes": "* The Differentials", "youtube_url": "https://www.youtube.com/watch?v=1kz6hNDlEEg&list=RD1kz6hNDlEEg&start_radio=1", "order": 5}}, {"model": "core.topic", "pk": 10, "fields": {"subject": 2, "title": "Basic Concepts of Trigonometry", "notes": "* Location of Angle\r\n* Rectangular Coordinate\r\n* The Distance Formula\r\n* Illustrative Problems", "youtube_url": "https://www.youtube.com/watch?v=1kz6hNDlEEg&list=RD1kz6hNDlEEg&start_radio=1", "order": 1}}, {"model": "core.topic", "pk": 11, "fields": {"subject": 2, "title": "Trigonometric Functions (Triangle and Circular Approaches)", "notes": "* The Triangle Approach\r\n* Table of Functions of Special and Quadrantal Angles\r\n* The Circular Approach\r\n* Illustrative Problems", "youtube_url": "https://www.youtube.com/watch?v=1kz6hNDlEEg&list=RD1kz6hNDlEEg&start_radio=1", "order": 2}}, {"model": "core.topic", "pk": 12, "fields": {"subject": 2, "title": "Solution of Right Triangles", "notes": "* Solution of Right Triangles\r\n* Angle of Elevation\r\n* Angle of Depression\r\n* Illustrative Problems", "youtube_url": "https://www.youtube.com/watch?v=1kz6hNDlEEg&list=RD1kz6hNDlEEg&start_radio=1", "order": 3}}, {"model": "core.topic", "pk": 13, "fields": {"subject": 2, "title": "Trigonometric Identities", "notes": "* Fundamental Identities\r\n* Proving and Simplifying Identities\r\n* Illustrative Problems", "youtube_url": "https://www.youtube.com/watch?v=1kz6hNDlEEg&list=RD1kz6hNDlEEg&start_radio=1", "order": 4}}, {"model": "core.topic", "pk": 14, "fields": {"subject": 2, "title": "Functions of Composite Angles", "notes": "* Sum or Difference of Two Angles\